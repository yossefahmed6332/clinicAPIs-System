{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ClinicDB;Integrated Security=True;TrustServerCertificate=True;"
},

  "JWT": {
    "Key": "REPLACE_WITH_YOUR_OWN_SECRET_KEY",
    "Issuer": "ClinicAPI",
    "Audience": "ClinicAPIUsers",
    "ExpireMinutes": 60
  },

  "AllowedHosts": "*"
}
